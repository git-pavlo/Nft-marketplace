# === Node / JavaScript ===
# dependencies
node_modules/

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# optional npm cache directory
.npm/

# dotenv environment files (keep .env.example, ignore real secrets)
.env
.env.*

# bundlers, frameworks, caches or build outputs
.cache/
.parcel-cache/
.next/
.out/
.nuxt/
dist/
.output/
.vite/
.svelte-kit/

# TypeScript build cache
*.tsbuildinfo

# IDEs and editors
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Mac system files
.DS_Store

# logs
*.log

# Misc
*.tgz

# === Hardhat / Solidity specific ===
# Hardhat-generated caches and build artifacts
cache/
artifacts/

# TypeChain typings (if generated)
typechain/

# coverage reports if you add coverage tooling
coverage/

# Solidity debugger or tool temporary files
*.dbg.json

# Optional: script output or temp directories you create
# e.g., /tmp/, /temp/
# tmp/
# temp/

# === Optional: OS or tooling ###
# Uncomment or add other patterns if you use additional tools or OS-specific dirs
